# Required: replace every placeholder. No credentials or API keys.
ENTRA_TENANT_ID=<directory-tenant-guid>
ENTRA_API_CLIENT_ID=<api-application-client-guid>
ENTRA_ALLOWED_CLIENT_IDS=<separate-caller-application-client-guid>
ENTRA_REQUIRED_SCOPE=Query.Read
ENTRA_GROUP_ACL_MAP='{"<finance-group-object-guid>":["finance-team"],"<employees-group-object-guid>":["employees"]}'
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=rag-chat-mini
RAG_AUDIT_LOG_PATH=./work/security_audit.jsonl
# In Azure, configure managed identity or federated workload identity using
# AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_FEDERATED_TOKEN_FILE as applicable.
